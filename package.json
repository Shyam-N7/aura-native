{
  "name": "AuraNative",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "call scripts\\env.cmd && react-native run-android",
    "android:debug": "call scripts\\env.cmd && cd android && call gradlew assembleDebug",
    "android:release": "call scripts\\env.cmd && cd android && call gradlew assembleRelease",
    "android:install": "call scripts\\env.cmd && adb install -r android\\app\\build\\outputs\\apk\\release\\app-release.apk",
    "adb:reverse": "call scripts\\env.cmd && adb reverse tcp:8081 tcp:8081",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@shopify/react-native-skia": "2.6.9",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "2.30.1",
    "react-native-image-picker": "8.2.1",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "4.2.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.19.0",
    "react-native-svg": "15.15.1",
    "react-native-track-player": "^4.1.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
